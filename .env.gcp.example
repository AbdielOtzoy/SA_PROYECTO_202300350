# Copiar como .env.gcp en la VM y protegerlo con chmod 600.
# No subir .env.gcp al repositorio.

PUBLIC_HOSTNAME=REEMPLAZAR_POR_IP_PUBLICA_O_DOMINIO
TLS_DIR=./deploy/tls

GCS_BUCKET=yousac-videos-yousac
GCS_PROJECT_ID=yousac
GCS_PREFIX=
VIDEO_STORAGE_MODE=gcs

# Genere un valor único en la VM con: openssl rand -hex 32
JWT_SECRET=REEMPLAZAR_JWT_SECRET_LARGO_Y_ALEATORIO
JWT_EXPIRES_IN=60m
PASSWORD_RESET_TTL_MINUTES=30
ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt

IDENTITY_DB_USER=yousac
IDENTITY_DB_PASSWORD=REEMPLAZAR_PASSWORD_IDENTITY
CATALOG_DB_USER=yousac
CATALOG_DB_PASSWORD=REEMPLAZAR_PASSWORD_CATALOG
NOTIFICATION_DB_USER=yousac
NOTIFICATION_DB_PASSWORD=REEMPLAZAR_PASSWORD_NOTIFICATIONS

IDENTITY_DATABASE_URL=postgres://yousac:REEMPLAZAR_PASSWORD_IDENTITY@identity-db:5432/identity_db
CATALOG_DATABASE_URL=postgres://yousac:REEMPLAZAR_PASSWORD_CATALOG@catalog-db:5432/catalog_db
NOTIFICATION_DATABASE_URL=postgres://yousac:REEMPLAZAR_PASSWORD_NOTIFICATIONS@notification-db:5432/notification_db
PLAYBACK_MONGO_URL=mongodb://playback-db:27017/playback_db
ANALYTICS_MONGO_URL=mongodb://analytics-db:27017/analytics_db
REDIS_URL=redis://redis:6379

MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
NOTIFICATION_POLL_INTERVAL_MS=30000
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=4
MAIL_SEND_TIMEOUT_MS=10000

GATEWAY_PORT=443
FRONTEND_URL=https://REEMPLAZAR_POR_IP_PUBLICA_O_DOMINIO
OAUTH_SUCCESS_URL=https://REEMPLAZAR_POR_IP_PUBLICA_O_DOMINIO/catalogo
OAUTH_FAILURE_URL=https://REEMPLAZAR_POR_IP_PUBLICA_O_DOMINIO/?oauth=error
GOOGLE_CALLBACK_URL=https://REEMPLAZAR_POR_IP_PUBLICA_O_DOMINIO/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_API_URL=/api

GRPC_TIMEOUT_MS=5000
CSV_MAX_BYTES=5242880
IDENTITY_GRPC_ADDRESS=identity:50051
CATALOG_GRPC_ADDRESS=catalog:50052
PLAYBACK_GRPC_ADDRESS=playback:50053
ANALYTICS_GRPC_ADDRESS=analytics:50054
NOTIFICATIONS_GRPC_ADDRESS=notifications:50055
IDENTITY_GRPC_BIND=0.0.0.0:50051
CATALOG_GRPC_BIND=0.0.0.0:50052
PLAYBACK_GRPC_BIND=0.0.0.0:50053
ANALYTICS_GRPC_BIND=0.0.0.0:50054
NOTIFICATIONS_GRPC_BIND=0.0.0.0:50055
