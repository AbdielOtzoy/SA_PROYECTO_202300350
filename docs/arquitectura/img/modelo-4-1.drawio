        <mxCell id="vlogica" value="&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Vista Lógica&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Modelo de dominio: Cuenta, Rol,&lt;br&gt;Inscripción, Curso, Grabación,&lt;br&gt;Progreso, Voto&lt;br&gt;&lt;br&gt;&lt;i&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Usuarios finales y analistas&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;arcSize=8;verticalAlign=middle;" vertex="1" parent="1">
