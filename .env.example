# Copie este archivo como .env antes de levantar los contenedores.
JWT_SECRET=change-this-local-secret-at-least-32-characters
JWT_EXPIRES_IN=60m
ALLOWED_EMAIL_DOMAINS=ingenieria.usac.edu.gt,ing.usac.edu.gt
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:3000/api/auth/google/callback
FRONTEND_URL=https://localhost:3000
OAUTH_SUCCESS_URL=https://localhost:3000/catalogo
OAUTH_FAILURE_URL=https://localhost:3000/?oauth=error
IDENTITY_DATABASE_URL=postgres://yousac:yousac@identity-db:5432/identity_db
CATALOG_DATABASE_URL=postgres://yousac:yousac@catalog-db:5432/catalog_db
NOTIFICATION_DATABASE_URL=postgres://yousac:yousac@notification-db:5432/notification_db
PLAYBACK_MONGO_URL=mongodb://playback-db:27017/playback_db
ANALYTICS_MONGO_URL=mongodb://analytics-db:27017/analytics_db
REDIS_URL=redis://redis:6379
MAILPIT_HOST=mailpit
MAILPIT_PORT=1025
GATEWAY_PORT=443
NEXT_PUBLIC_API_URL=https://localhost:443/api
# Direcciones internas gRPC y tiempos máximos de llamadas del Gateway.
GRPC_TIMEOUT_MS=5000
CSV_MAX_BYTES=5242880
IDENTITY_GRPC_ADDRESS=identity:50051
CATALOG_GRPC_ADDRESS=catalog:50052
PLAYBACK_GRPC_ADDRESS=playback:50053
ANALYTICS_GRPC_ADDRESS=analytics:50054
NOTIFICATIONS_GRPC_ADDRESS=notifications:50055
IDENTITY_GRPC_BIND=0.0.0.0:50051
CATALOG_GRPC_BIND=0.0.0.0:50052
PLAYBACK_GRPC_BIND=0.0.0.0:50053
ANALYTICS_GRPC_BIND=0.0.0.0:50054
NOTIFICATIONS_GRPC_BIND=0.0.0.0:50055
# Sólo se usa en docker-compose.cloud.yml; el proveedor GCS no se configura localmente.
VIDEO_STORAGE_MODE=local
GCS_BUCKET=
GCS_PROJECT_ID=
